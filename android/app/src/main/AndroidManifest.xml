<!-- android:installLocation="auto" is what makes the app eligible to be moved to adoptable
     storage (a USB drive adopted by an Android TV, an adopted SD card), which relocates the
     private data directory — and therefore downloads — along with the APK. Plezy declares none
     of the components this is unsafe for: no app widget, IME, live wallpaper, device admin,
     accessibility service, sync adapter or account authenticator. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Plebz: held only by apps signed with this app's key (a launcher of its own), which read the
         home rows through HomeRowsProvider without asking. -->
    <permission
        android:name="app.plebz.permission.HOME_ROWS"
        android:protectionLevel="signature" />
    <!-- Plebz: hand a downloaded update to the system installer (the viewer confirms it). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>


    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.REORDER_TASKS"/>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

    <!-- Explicitly remove media permissions that media_kit may add -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <!-- Plebz: choosing a local file (an M3U playlist, a backup) on boxes
         without the system's document picker. Asked for only then, and only
         by the user's own action. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" tools:node="replace" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- Plebz: in_app_purchase (Supporter, off in this build) merges Play Billing in; the APK
         takes neither its permission nor its query for the Play Store. -->
    <uses-permission android:name="com.android.vending.BILLING" tools:node="remove" />


    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Plebz: guide reminders to the minute on phones and tablets. Android 13+ grants
         USE_EXACT_ALARM with the install; 12 and 12L grant SCHEDULE_EXACT_ALARM by default. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <!-- allowBackup="false": Android's Auto Backup and device transfer would carry the
         preferences and the database — server tokens, tracker sessions, IPTV passwords and
         the key that seals them — into the Google account's backup, unencrypted end to end
         on a box without a screen lock. Moving to a new device goes through the app's own
         password-protected backup (Alle Einstellungen → Sicherung) instead. -->
    <application
        android:label="Plebz"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:appCategory="video"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">
        <!-- Driver-distraction state on Android Automotive OS. Optional: the platform library is
             absent on every other form factor, and CarRestrictionsMonitor falls back silently. -->
        <uses-library android:name="android.car" android:required="false" />
        <!-- The activity itself has no launcher entry: the launcher components are the aliases
             below, so the app icon can be switched by enabling one alias and disabling the rest.
             Deep links stay here so they resolve whichever alias is enabled.
             turnScreenOn lets a plebz:// link sent during the screensaver (e.g. by a home
             automation) wake the device; set at runtime it comes too late, as the activity
             is already launched behind the screensaver. -->
        <activity
            android:name=".PlezyActivity"
            android:turnScreenOn="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <!-- The plebz:// links of upstream's grammar. DeepLinkPlugin forwards the URL unchanged;
                 the grammar lives in lib/services/deep_links/deep_link.dart (the home-row tiles' hosts
                 in lib/utils/home_link.dart). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="plebz" android:host="open"/>
                <data android:host="play"/>
                <data android:host="live"/>
                <data android:host="external-player"/>
            </intent-filter>
            <!-- Plebz: the links only a home-row tile opens (watchlist, sport, now). Not
                 BROWSABLE: a web page cannot fire them, only an app's intent. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="plebz" android:host="watchlist"/>
                <data android:host="sport"/>
                <data android:host="now"/>
            </intent-filter>
        </activity>
        <!-- The default icon. Keep this component name forever: it was the launcher activity before
             app icons became switchable, so every existing home-screen shortcut, TV favourite and
             recent task points at it. The meta-data repeats the activity's because FlutterActivity
             reads it from the component that launched it. -->
        <activity-alias
            android:name=".MainActivity"
            android:exported="true"
            android:targetActivity=".PlezyActivity">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Plebz: no alternate icons. The .appicon.* aliases (AppIconChannel) stay out of the
             APK on purpose; Plebz keeps its own logo. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.plebz.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
        <!-- Launcher shelf artwork. Not exported: readers reach it only through the
             per-URI read grants issued to CATEGORY_HOME packages by WatchNextProvider. -->
        <!-- Plebz: the home rows for a launcher signed with this app's key; signature permission only. -->
        <provider
            android:name=".homerows.HomeRowsProvider"
            android:authorities="app.plebz.homerows"
            android:exported="true"
            android:readPermission="app.plebz.permission.HOME_ROWS"
            android:writePermission="app.plebz.permission.HOME_ROWS" />
        <provider
            android:name=".watchnext.SystemShelfArtworkProvider"
            android:authorities="app.plebz.systemshelf.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />
        <receiver
            android:name=".ProgramReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".watchnext.SystemShelfUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Setting this stops FlutterLoader from appending its half-of-RAM default after
             PlezyActivity's shell args, where it would override the low-RAM cap. PlezyActivity
             always passes the per-device value; this one applies only if another engine
             initializes Flutter first. -->
        <meta-data
            android:name="io.flutter.embedding.android.OldGenHeapSize"
            android:value="256" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Plebz: Play Billing's own query for its service stays out with its permission. -->
        <intent tools:node="remove">
            <action android:name="com.android.vending.billing.InAppBillingService.BIND" />
        </intent>
        <!-- Plebz: whether this box has the system's document picker. -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required for url_launcher to open HTTPS URLs -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <!-- Required to resolve external video player apps on Android 11+ -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <!-- Lets a catalog trailer reach the YouTube app rather than a
             browser tab: on Android 11+ an app it cannot see is an app it
             cannot hand the video to. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vnd.youtube" />
        </intent>
        <!-- Required to identify HOME launchers as shelf artwork consumers. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
</manifest>
