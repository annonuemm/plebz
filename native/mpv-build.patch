diff --git a/patches/mbedtls/pool/0001-android-entropy-no-blocking.patch b/patches/mbedtls/pool/0001-android-entropy-no-blocking.patch
new file mode 100644
index 0000000..6d5373d
--- /dev/null
+++ b/patches/mbedtls/pool/0001-android-entropy-no-blocking.patch
@@ -0,0 +1,35 @@
+diff --git a/include/mbedtls/platform.h b/include/mbedtls/platform.h
+index f1ec997..7b9edb6 100644
+--- a/include/mbedtls/platform.h
++++ b/include/mbedtls/platform.h
+@@ -395,8 +395,14 @@ int mbedtls_platform_set_exit(void (*exit_func)(int status));
+ #endif
+ 
+ #if !defined(MBEDTLS_PLATFORM_DEV_RANDOM)
++#if defined(__ANDROID__)
++/* Android seeds urandom early and never blocks on it; /dev/random can block
++ * on kernels before 5.6. Only reached when getrandom() is missing. */
++#define MBEDTLS_PLATFORM_DEV_RANDOM "/dev/urandom"
++#else
+ #define MBEDTLS_PLATFORM_DEV_RANDOM "/dev/random"
+ #endif
++#endif
+ 
+ /* Arrange for mbedtls_platform_dev_random to always be visible to
+  * Doxygen, because it's linked from the documentation of
+diff --git a/library/entropy_poll.c b/library/entropy_poll.c
+index 1c8a29d..5bf459e 100644
+--- a/library/entropy_poll.c
++++ b/library/entropy_poll.c
+@@ -75,7 +75,10 @@ int mbedtls_platform_entropy_poll(void *data, unsigned char *output, size_t len,
+  * Since there is no wrapper in the libc yet, use the generic syscall wrapper
+  * available in GNU libc and compatible libc's (eg uClibc).
+  */
+-#if ((defined(__linux__) && defined(__GLIBC__)) || defined(__midipix__))
++/* Android's bionic has the same generic syscall wrapper. Without this, it
++ * fell through to MBEDTLS_PLATFORM_DEV_RANDOM, which blocks on the older
++ * kernels many TV boxes run until enough entropy has been gathered. */
++#if ((defined(__linux__) && (defined(__GLIBC__) || defined(__ANDROID__))) || defined(__midipix__))
+ #include <unistd.h>
+ #include <sys/syscall.h>
+ #if defined(SYS_getrandom)
